.{
    .name = .zilc,
    .version = "0.15.2-0.687.1",
    .fingerprint = 0x7f337b02f7aa97ab, // Changing this has security and trust implications.
    // Pinned to the Zig whose bundled LLVM matches Fil-C's (0.15.2 = LLVM 20). See cmem/known-issues.md KI-3.
    .minimum_zig_version = "0.15.2",
    .dependencies = .{
        // Fil-C's sources at the compiler commit of the release zilc is on (src/gen/signatures.zig),
        // fetched by the first step that reads them (build/filc_source.zig). Moves with every Fil-C
        // release: `zig fetch <url>` for the hash, then tools/upstream/verify-filc-package.ts and
        // `zig build check-pins` (cmem/releasing.md). 2.2 GB download, 11 GB unpacked (2026-10-30).
        .filc = .{
            .url = "https://github.com/pizlonator/llvm-project-deluge/archive/e7947f079c976fb167108f7407c20240bca0ca89.tar.gz",
            .hash = "N-V-__8AAP____80boa7EOMLjvmp6wDDfdSz7GvZvZx_e-rl",
            .lazy = true,
        },
        // LLVM's build system for `zig build patched-clang`, fetched only with the user's opt-in
        // `-Dfetch-build-tools` (owner, 2026-10-30); else cmake and ninja come from PATH. Official
        // release binaries, checked at pinning against their publishers' SHA-256 (Kitware's
        // cmake-4.2.3-SHA-256.txt: 5bb505d5…0c23; GitHub's asset digest for ninja-linux.zip:
        // 0830252d…0238). Re-checked on every Fil-C move (cmem/releasing.md).
        .cmake = .{
            .url = "https://github.com/Kitware/CMake/releases/download/v4.2.3/cmake-4.2.3-linux-x86_64.tar.gz",
            .hash = "N-V-__8AAGbjHwrGnmA5KvztaSpwjOorHvTpN-8s9hoQpQsT",
            .lazy = true,
        },
        .ninja = .{
            .url = "https://github.com/ninja-build/ninja/releases/download/v1.13.1/ninja-linux.zip",
            .hash = "N-V-__8AAHBwBADunxW-KasDAM8DFYcfQXxzXXW6NvPfJqmt",
            .lazy = true,
        },
        // MAINTAINER-ONLY (owner, 2026-10-30: GCC is for quality control, never a user's build):
        // the GCC versions Fil-C's release was built with (11.4.0: compiler-rt; 12.3.0: yolo
        // musl), and their math prerequisites, for `zig build gcc-reference`. GNU's release
        // tarballs; each one's GPG signature was checked against GNU's keyring when pinned
        // (2026-11-04: GCC 11.4.0 by Jakub Jelinek, 12.3.0 by Richard Guenther).
        .gcc_11_4_0 = .{
            .url = "https://ftp.gnu.org/gnu/gcc/gcc-11.4.0/gcc-11.4.0.tar.xz",
            .hash = "N-V-__8AAJdpFSWU5TEpT8OSfDbzToGhmPgErYWFALVNHk3c",
            .lazy = true,
        },
        .gcc_12_3_0 = .{
            .url = "https://ftp.gnu.org/gnu/gcc/gcc-12.3.0/gcc-12.3.0.tar.xz",
            .hash = "N-V-__8AAEaozSb97ycxmnMJ4X8Nv8beiJwUdeTxUpbzPItq",
            .lazy = true,
        },
        .gmp = .{
            .url = "https://ftp.gnu.org/gnu/gmp/gmp-6.2.1.tar.xz",
            .hash = "N-V-__8AAPH07QCiCQcxopYxHV_Oob1MZiOzma6hzTT4Q9Be",
            .lazy = true,
        },
        .mpfr = .{
            .url = "https://ftp.gnu.org/gnu/mpfr/mpfr-4.1.0.tar.xz",
            .hash = "N-V-__8AALesrQBnl1vQgTJchJmZ4PrFhE-KX8W2-OuMl45B",
            .lazy = true,
        },
        .mpc = .{
            .url = "https://ftp.gnu.org/gnu/mpc/mpc-1.2.1.tar.gz",
            .hash = "N-V-__8AALVcOADkUDdW61VUhAP9t80cvE8YnEiHQbqsqFIo",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "include",
        "third_party",
        "LICENSE-MIT",
        "LICENSE-APACHE",
        "NOTICE",
        "README.md",
    },
}
